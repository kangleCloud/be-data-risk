# 本地复制为 .env.dev；生产复制为 .env.prod，真实凭据不提交。
# 由启动命令 --config 选择文件，不在此文件中配置 APP_ENV。
# 示例：.venv/bin/python -m risk --config .env.dev

# Redis：与业务后端同一实例和 DB 2，风控使用独立 risk:v1: 命名空间。
# REDIS_URL 填主机名，不填完整 URI；容器访问宿主机填 host.docker.internal。
# 密码中的空格、# 等特殊字符需加引号，程序自动进行 URL 编码。
REDIS_URL=localhost
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_DB=2
# 使用 Redis ACL 时可额外设置 REDIS_USERNAME，默认空。

# Nginx 日志：填写实际绝对路径；SOURCE_ID 一旦投入使用应保持稳定。
# 路径留空时不启动采集；不预设生产日志路径。
SOURCE_ID=nginx_access
SOURCE_LOG_PATH=

# Java统一离线地域服务；留空时仅读有效共享缓存，缺失结果按UNKNOWN计数。
# 使用运维明确配置的固定IP（可为公网IP）；实际端口及/stock前缀按Java部署核实。
GEO_SERVICE_URL=
# 与Java内部接口配置一致的私有令牌，不能填写到可跟踪样例。
GEO_SERVICE_TOKEN=

# 本部署：雷池127.0.0.1回源，Nginx RealIP已将真实来源写入 $remote_addr。
# 仅在 examples/nginx-waf-realip.conf.example 生效后使用true；其他拓扑需另行核实。
# Python直接信任规范化后的remote_addr，不再解析客户端XFF。
TRUSTED_PROXIES=
DIRECT_PEER_TRUSTED=true

# 文件读取：单行字节上限、空闲轮询间隔（毫秒）。
MAX_LINE_BYTES=65536
POLL_MILLIS=200

# 可选路径分组：不配置也统计所有合法API，不能绕过脱敏或覆盖分类。
# PATH_RULES='[]'
# 多日志源用 SOURCES 替代 SOURCE_LOG_PATH，不能同时配置。
# SOURCES='[{"alias":"nginx_access","path":"<ABSOLUTE_LOG_PATH>"}]'
