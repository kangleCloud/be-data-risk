# 本地复制为 .env.dev；生产复制为 .env.prod，真实凭据不提交。
# 由启动命令 --config 选择文件，不在此文件中配置 APP_ENV。
# 示例：.venv/bin/python -m risk --config .env.dev

# Redis：与业务后端同一实例和 DB 2，风控使用独立 risk:v1: 命名空间。
# REDIS_URL 填主机名，不填完整 URI；容器访问宿主机填 host.docker.internal。
# 密码中的空格、# 等特殊字符需加引号，程序自动进行 URL 编码。
REDIS_URL=localhost
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_DB=2
# 使用 Redis ACL 时可额外设置 REDIS_USERNAME，默认空。

# Nginx 日志：填写实际绝对路径；SOURCE_ID 一旦投入使用应保持稳定。
# 路径留空时不启动采集；不预设生产日志路径。
SOURCE_ID=nginx_access
SOURCE_LOG_PATH=

# 隐私：至少32字节随机密钥文件的绝对路径，不填写密钥正文。
HMAC_KEY_FILE=
# 可选的本地 MaxMind 数据库绝对路径；缺失时地域未知，不访问外网。
GEO_DATABASE=

# 可信代理：多个 CIDR 用逗号分隔；未核实前留空、不信任转发头。
TRUSTED_PROXIES=
DIRECT_PEER_TRUSTED=false

# 文件读取：单行字节上限、空闲轮询间隔（毫秒）。
MAX_LINE_BYTES=65536
POLL_MILLIS=200

# 可选路径分组：不配置也统计所有合法请求，不能绕过脱敏或覆盖分类。
# PATH_RULES='[]'
# 多日志源使用原 RISK_SOURCES JSON 数组替代 SOURCE_LOG_PATH，勿同时配置。
# RISK_SOURCES='[{"alias":"nginx_access","path":"<ABSOLUTE_LOG_PATH>"}]'
